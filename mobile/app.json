{
  "expo": {
    "name": "SpeakUp Eco",
    "slug": "ecoradar",
    "scheme": "ecoradar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.facens.ecoradar",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O SpeakUp Eco usa sua localização para marcar onde está a ocorrência e mostrar pontos de descarte próximos.",
        "NSCameraUsageDescription": "O SpeakUp Eco usa a câmera para fotografar a ocorrência ambiental.",
        "NSPhotoLibraryUsageDescription": "O SpeakUp Eco acessa sua galeria para anexar fotos à denúncia.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.edu.facens.ecoradar",
      "adaptiveIcon": {
        "backgroundColor": "#176B56",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O SpeakUp Eco usa sua localização para marcar onde está a ocorrência e mostrar pontos de descarte próximos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O SpeakUp Eco acessa sua galeria para anexar fotos à denúncia.",
          "cameraPermission": "O SpeakUp Eco usa a câmera para fotografar a ocorrência ambiental."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#176B56"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9a3dc979-f2cd-4038-abd9-d76436f98813"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "pedroxd7k"
  }
}
